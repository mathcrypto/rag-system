# API keys & secrets

OPENAI_API_KEY=your-key-here

# LangSmith tracing (https://smith.langchain.com)
# Create an API key under Settings → API Keys, then set the project name
# to match your LangSmith project (e.g. RAG-project).
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=RAG-project

# Optional: Hugging Face read token (tokenizer downloads / higher Hub rate limits)
# Create at https://huggingface.co/settings/tokens — use Read access, not full access
HF_TOKEN=hf_your-token-here
